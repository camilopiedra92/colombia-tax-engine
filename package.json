{
  "name": "colombia-tax-engine",
  "version": "1.0.0",
  "description": "Colombian Tax Engine - Declaración de Renta Personas Naturales (Formulario 210)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "USAGE.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "TMPDIR=\"$(pwd)/.tmp\" vitest run",
    "test:watch": "TMPDIR=\"$(pwd)/.tmp\" vitest",
    "test:coverage": "TMPDIR=\"$(pwd)/.tmp\" vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "colombia",
    "tax",
    "tax-engine",
    "tax-calculator",
    "declaracion-renta",
    "formulario-210",
    "dian",
    "estatuto-tributario"
  ],
  "author": "Tax Optimizer Team",
  "license": "MIT",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/camilopiedra92/colombia-tax-engine.git"
  },
  "homepage": "https://github.com/camilopiedra92/colombia-tax-engine#readme",
  "bugs": {
    "url": "https://github.com/camilopiedra92/colombia-tax-engine/issues"
  }
}
